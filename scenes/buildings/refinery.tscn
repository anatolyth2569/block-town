[gd_scene format=3 uid="uid://db6d58vwyoris"]

[sub_resource type="GDScript" id="AnimScript"]
script/source = "extends Node3D\n\nvar elapsed := 0.0\n\n@onready var smokes := [\n\t$Pivot_Fix_180Y/Model/FactoryCluster/Flare/Smoke_1,\n\t$Pivot_Fix_180Y/Model/FactoryCluster/Flare/Smoke_2,\n\t$Pivot_Fix_180Y/Model/FactoryCluster/Flare/Smoke_3\n]\n@onready var flame := $Pivot_Fix_180Y/Model/FactoryCluster/Flare/Flame\n@onready var flow_dots := [\n\t$Pivot_Fix_180Y/Model/FactoryCluster/Pipes/FlowDot_1,\n\t$Pivot_Fix_180Y/Model/FactoryCluster/Pipes/FlowDot_2,\n\t$Pivot_Fix_180Y/Model/FactoryCluster/Pipes/FlowDot_3\n]\n\nvar smoke_base := [Vector3(0.0, 2.42, 0.0), Vector3(-0.04, 2.62, 0.02), Vector3(0.05, 2.84, -0.02)]\nvar smoke_size := [0.12, 0.14, 0.13]\nvar smoke_phase := [0.0, 1.1, 2.1]\n\nvar flow_paths := [\n\t[Vector3(-0.56, 1.12, -0.18), Vector3(-0.20, 1.12, -0.20), Vector3(-0.02, 1.46, -0.22)],\n\t[Vector3(0.05, 1.40, -0.10), Vector3(0.56, 1.22, -0.20), Vector3(0.96, 1.00, 0.26)],\n\t[Vector3(0.96, 1.00, 0.26), Vector3(1.44, 1.46, -0.78)]\n]\nvar flow_speed := [0.30, 0.24, 0.26]\nvar flow_offset := [0.0, 0.35, 0.60]\n\nfunc sample_polyline(points: Array, u: float) -> Vector3:\n\tif points.size() <= 1:\n\t\treturn points[0]\n\tvar segment_count := points.size() - 1\n\tvar scaled := u * float(segment_count)\n\tvar idx = min(int(floor(scaled)), segment_count - 1)\n\tvar local_t := scaled - float(idx)\n\treturn points[idx].lerp(points[idx + 1], local_t)\n\nfunc _process(delta: float) -> void:\n\tif not is_instance_valid(flame):\n\t\treturn\n\telapsed += delta\n\tfor i in smokes.size():\n\t\tvar base: Vector3 = smoke_base[i]\n\t\tvar phase: float = smoke_phase[i]\n\t\tvar s: float = smoke_size[i]\n\t\tvar pulse := 1.0 + sin(elapsed * 1.4 + phase) * 0.06\n\t\tsmokes[i].position = Vector3(\n\t\t\tbase.x + sin(elapsed * 0.75 + phase) * 0.03,\n\t\t\tbase.y + fmod(elapsed * 0.05 + phase * 0.02, 0.18),\n\t\t\tbase.z\n\t\t)\n\t\tsmokes[i].scale = Vector3(s * 1.1 * pulse, s * 0.70 * pulse, s * pulse)\n\n\tvar flicker := 1.0 + sin(elapsed * 10.5) * 0.12 + sin(elapsed * 18.0) * 0.05\n\tflame.scale = Vector3(0.95 + flicker * 0.10, flicker, 0.95 + flicker * 0.08)\n\tflame.rotation.y += 0.03\n\n\tfor i in flow_dots.size():\n\t\tvar t := fmod(elapsed * flow_speed[i] + flow_offset[i], 1.0)\n\t\tflow_dots[i].position = sample_polyline(flow_paths[i], t)\n\t\tvar p := 0.85 + sin(elapsed * 8.0 + flow_offset[i] * 10.0) * 0.15\n\t\tflow_dots[i].scale = Vector3(p, p, p)\n"

