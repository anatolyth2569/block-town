[gd_scene format=3 uid="uid://dq0s06rii1cff"]

[sub_resource type="GDScript" id="RippleAnim"]
script/source = "extends Node3D

func _ready() -> void:
	var ring1 = get_node_or_null(\"Ripple1\")
	var ring2 = get_node_or_null(\"Ripple2\")
	_animate_ring(ring1, 0.0)
	_animate_ring(ring2, 0.8)

func _animate_ring(ring: MeshInstance3D, delay: float) -> void:
	if not is_instance_valid(ring):
		return
	var src = ring.get_surface_override_material(0)
	if src == null:
		return
	var mat: StandardMaterial3D = (src as StandardMaterial3D).duplicate()
	ring.set_surface_override_material(0, mat)
	var tw := create_tween()
	tw.set_loops()
	if delay > 0:
		tw.tween_interval(delay)
	tw.tween_property(ring, \"scale\", Vector3.ONE * 2.2, 1.4).from(Vector3.ONE * 0.2)
	tw.parallel().tween_method(func(v: float): mat.albedo_color.a = v, 0.75, 0.0, 1.4)
	tw.tween_callback(func():
		ring.scale = Vector3.ONE * 0.2
		mat.albedo_color.a = 0.75
	)
"

